<worksheet xml:id="Math211Fa24-FinalExam-PracticeA" xmlns:xi="http://www.w3.org/2001/XInclude">
	<title>Math211Fa24-FinalExam-PracticeA</title>
	<exercise>
		<introduction>
			<p>
				Are each of the following true or false statements? Fill in the bubble next to the correct answer. Justification is not necessary.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					If <m>f(x,y)=\dfrac{\ln(2x)}{y}</m>, the domain of <m>f(x,y)</m> is <m>\{(x,y)|x&gt;0, y&gt;0\}.</m>
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					The improper integral <m>\displaystyle\int_{9}^\infty \dfrac{4}{x^2}dx</m> is divergent.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					The improper integral <m>\displaystyle\int_{9}^\infty \dfrac{4}{\sqrt{x}}dx</m> is divergent.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice correct="yes">
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					An equation for the tangent line of <m>f(x)=2x^3+4x</m> at <m>x=-1</m> is <m>y=10x+4</m>.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice correct="yes">
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					The area between the curves <m>y=\frac{x^2}{4}-2</m> and <m>y=\frac{x}{2}</m> (see graph below) is given by the integral <m>\displaystyle\int_{-2}^4\left(\frac{x^2}{4}-2-\frac{x}{2}\right)dx</m>.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Calculate the derivative of each function. You do not need to simplify your answer.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					<m>f(x)=\displaystyle\frac{1}{2x^4}-\sqrt{3x}+e^2</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp f(x)=\frac{1}{2} x^{-4}-\sqrt{3} x^{1 / 2}+e^2 \\
						\amp f'(x)=-\frac{4}{2} x^{-5}-\frac{\sqrt{3}}{2} x^{-1 / 2}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle g(x)=e^{x^2+2x}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						g'(x)=e^{x^2+2 x} \cdot(2 x+2) .
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>F(x)=(3x^4+e^x)^8</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						F'(x)=8\left(3 x^4+e^x\right)^7 \cdot\left(12 x^3+e^x\right)
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>r(x)=(4x^3+7x)\ln(x)</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						r'(x)=\left(12 x^2+7\right) \ln (x)+\left(4 x^3+7 x\right) \cdot \frac{1}{x} .
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Calculate each integral. You do not need to simplify your answer. Show all work.
			</p>
			<p>
				
			</p>
		</introduction>
		<task workspace="1.75in">
			<statement>
				<p>
					<m>\displaystyle\int \left(10x^4+\dfrac{8}{x}+\dfrac{3}{x^2}\right)dx</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						=\frac{10 x^5}{5}+8 \ln|x|+\frac{3 x^{-1}}{-1}+C
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle\int \sqrt{x}(4x^3+7) dx</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp \int \sqrt{x}\left(4 x^3+7\right) d x=\int 4 x^{3+1 / 2}+7 x^{1 / 2} d x \\
						\amp =\int 4 x^{7 / 2}+7 x^{1 / 2} d x=\frac{4 x^{7 / 2+1}}{\frac{7}{2}+1}+\frac{7 x^{3 / 2}}{3 / 2}+C
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle\int \left( 4e^{2x} + \dfrac{1}{2} \right)dx</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						=\frac{4 e^{2 x}}{2}+\frac{1}{2} x+C
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				A company’s marginal cost function is <m>MC(x)=2e^{-x}</m>, where <m>x</m> is the number of units. Find the total cost of producing the first hundred units (<m>x=0</m> to <m>x=100</m>). Show all work. You do not need to simplify your final numerical answer. 
			</p>
		</introduction>
		<solution>
			<p>
				We need to compute
				<me>
					\begin{aligned}
					\amp \int_0^{100} 2 e^{-x} d x=\left.\frac{2 e^{-x}}{-1}\right|_0 ^{100} \\
					\amp =\left.\frac{-2}{e^x}\right|_0 ^{100}=\frac{-2}{e^{100}}+\frac{2}{e^0} \\
					\amp =2-\frac{2}{e^{100}} .
					\end{aligned}
				</me>
				The total cost of producing the first 100 units is <m>2-\frac{2}{e^{100}}.</m>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find the average value of <m>f(x)=x-3\sqrt{x}</m> on the interval <m>[1,4]</m>.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{aligned}
					\operatorname{Arg}(f) \amp =\frac{1}{4-1} \int_1^4(x-3 \sqrt{x}) d x \\
					\amp =\left.\frac{1}{3}\left(\frac{x^2}{2}-\frac{3 x^{3 / 2}}{3 / 2}\right)\right|_1 ^4 \\
					\amp =\frac{1}{3}\left(\frac{16}{2}-3 \cdot \frac{2}{3} \cdot(\sqrt{4})^3\right)-\frac{1}{3}\left(\frac{1}{2}-3 \cdot \frac{2}{3}\right)
					\end{aligned}
				</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				A parking lot owner has <m>450</m> parking spots to rent out. If the owner charges <m>x</m> dollars per parking spot, the number of spots that will be rented out is given by the function
			</p>
			<p>
				<me>f(x)= 450-10x.</me>
			</p>
		</introduction>
		<task workspace="3in">
			<statement>
				<p>
					Find <m>R(x)</m>, where <m>R(x)</m> is the revenue the parking lot owner receives as a function of <m>x</m>.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						R(x)=x \cdot(450-10 x)
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					What price should the parking lot owner charge to maximize revenue? Justify your solution is optimal. Show all work.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp R(x)=450 x-10 x^2 \\
						\amp M R(x)=450-20 x=0 \Rightarrow x=\frac{450}{20} \\
						\amp R''(x)=-20 \lt 0, \text { so there's a max at } x=\frac{45}{2} .
						\end{aligned}
					</me>
					The owner should charge <m>\$ \frac{45}{2}</m> per parking spot.
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Reminder: If <m>d(x)</m> is the demand function, and <m>s(x)</m> is the supply function,
			</p>
			<p>
				<m>(\text{Consumers' surplus for $d(x)$ at demand level $A$})=\displaystyle\int_0^A[d(x)-B]dx</m> (where <m>B=d(A)</m>)
			</p>
			<p>
				<m>(\text{Producers' surplus for $s(x)$ at demand level $A$})=\displaystyle\int_0^A[B-s(x)]dx</m> (where <m>B=s(A)</m>)
			</p>
			<p>
				Suppose a product has demand function <m>d(x)=300-\frac{1}{2}x^2</m> and supply function <m>s(x)=\frac{1}{4}x^2</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Find the <term>producers’ surplus</term> at demand level <m>A=10</m>. Show all work. Evaluate the integral, but you do not need to simplify your final numerical answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp \int_0^{10}[s(10)-s(x)] d x \\
						= \amp \int_0^{10}\left[\frac{1}{4} \cdot 10^2-\frac{1}{4} x^2\right] d x \\
						= \amp \left.\left(\frac{1}{4} \cdot 10^2 \cdot x-\frac{1}{4} \frac{x^3}{3}\right)\right|_0 ^{10} \\
						= \amp \frac{1}{4} \cdot 10^2 \cdot 10-\frac{1}{4} \cdot \frac{10^3}{3} .
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task workspace="3in">
			<statement>
				<p>
					Find the <term>market demand</term> (the positive value of <m>x</m> where supply and demand are equal). Show all work. Simplify your final answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp 300-\frac{1}{2} x^2=\frac{1}{4} x^2 \\
						\amp 300=\left(\frac{1}{4}+\frac{1}{2}\right) x^2 \\
						\amp 300=\frac{3}{4} x^2 \\
						\amp \frac{300 \cdot 4}{3}=x^2 \\
						\amp 100 \cdot 4=x^2 \quad \Rightarrow x^2=400\quad \Rightarrow x=20
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				For <m>f(x,y)=x^3+y^2-12x+6y</m>:
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					Find the partial derivative <m>f_x</m>.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						f_x=3 x^2-12
					</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					Find the partial derivative <m>f_y</m>.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						f_y=2 y+6
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Find all the critical points of <m>f(x,y)</m>. Write each in the form <m>(x,y)</m>. Show all work.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp \left\{\begin{array}{l}
						3 x^2-12=0 \\
						2 y+6=0
						\end{array}\right. \\
						\amp 3 x^2-12=3\left(x^2-4\right)=3(x-2)(x+2)=0 \text { at } x=2 \text{ and } x=-2 . \\
						\amp 2 y+6=0 \text { at } y=-3 .
						\end{aligned}
					</me>
					critical points: <m>(2,-3)</m> and <m>(-2,-3)</m>.
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Use the graph of <m>y=f'(x)</m> to answer the following. Briefly justify your answers.
			</p>
			<p>
				Again, <term>this is the graph of the derivative of <m>f(x)</m>.</term>
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					On which interval(s) is <m>f(x)</m> increasing? Briefly justify your answer.
				</p>
				<p>
					
				</p>
			</statement>
			<solution>
				<p>
					<m>f</m> is increasing when <m>f'(x)</m> is positive. Then <m>f</m> is
					<me>
						\text { increasing on }(-\infty,-3) \cup(-1,4) \text {. }
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Is <m>f(x)</m> concave up or concave down at <m>x=-4</m>? Briefly justify your answer.
				</p>
				<p>
					
				</p>
			</statement>
			<solution>
				<p>
					At <m>x=-4</m>, <m>f'</m> is decreasing, so <m>\left(f'\right)' \lt 0</m>. That is, <m>f'' \lt 0</m>,
					so <m>f</m> is concave down.
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					What is <m>\displaystyle \lim_{h\to0}\frac{f(3+h)-f(3)}{h}</m>? Briefly justify your answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\lim _{h \rightarrow 0} \frac{f(3+h)-f(3)}{h}=f'(3)=4 .
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				For the function <m>f(x,y)=x^3-y^3-9xy+4</m>:
			</p>
		</introduction>
		<task workspace="3in">
			<statement>
				<p>
					Compute <m>f_{xx}, f_{yy},</m> and <m>f_{xy}</m>. Show all work.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{array}{ll}
						f_x=3 x^2-9 y \amp f_y=-3 y^2-9 x \\
						f_{x x}=6 x \amp f_{y y}=-6 y \\
						f_{x y}=-9 \amp
						\end{array}
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					The critical points of <m>f(x,y)</m> are <m>(0,0)</m> and <m>(-3,3)</m>. Determine, using the <m>D</m>-test, if each point corresponds to a relative maximum, relative minimum, or saddle point. Show all work.
				</p>
				<p>
					Reminder: <m>D=f_{xx}(a,b)f_{yy}(a,b)-[f_{xy}(a,b)]^2</m>
				</p>
			</statement>
			<solution>
				<p>
					At <m>(0,0)</m>,
					<m>D=0.0-(-9)^2=-81 \lt 0</m> saddle point.
					
					At <m>(-3,3)</m>,
					<me>
						\begin{aligned}
						D \amp =6(-3) \cdot(-6 \cdot 3)-(-9)^2 \\
						\amp =6 \cdot 3 \cdot 6 \cdot 3-81 \\
						\amp =2 \cdot 3 \cdot 3 \cdot 2 \cdot 3 \cdot 3-81 \\
						\amp =81 \cdot 4-81=81 \cdot 3 \gt 0, \text { and } f_{x x}(-3,3)=-18 \lt 0
						\end{aligned}
					</me>
					Local max at <m>(-3,3)</m>.
				</p>
			</solution>
		</task>
	</exercise>
</worksheet>
