					</choice>
					<choice>
						<statement>
							<p>
								None of the above.
							</p>
						</statement>
					</choice>
				</choices>
		</task>
	</exercise>
        <exercise>
                <introduction>
                        <p>
                                Find the average value of <m>f(x)=6x+\dfrac{3}{4x}</m> on <m>[2,5]</m>. Show all work. You do not need to simplify your final numerical answer.
                        </p>
                </introduction>
                <solution>
                        <p>
                                <md>
                                        \frac{1}{5-2} \int_2^5\left(6 x+\frac{3}{4 x}\right) d x=\left.\frac{1}{3}\left(\frac{6 x^2}{2}+\frac{3}{4} \ln |x|\right)\right|_2 ^5
                                </md>
                                <md>
                                        =\frac{1}{3}\left(3 \cdot 5^2+\frac{3}{4} \ln (5)-\left(3 \cdot 2^2+\frac{3}{4} \ln (2)\right)\right)
                                </md>
                        </p>
                </solution>
        </exercise>
        <exercise>
                <introduction>
                        <p>
                                A concert venue seats 200 people. When they price the tickets at <m>\$60</m>, all 200 tickets will sell. They estimate that for each <m>\$3</m> increase in price, they will sell 5 fewer tickets. Find the price of concert ticket which will maximize their revenue. Justify your solution gives the maximum revenue. Show all work.
                        </p>
                </introduction>
                <solution>
                        <p>
                                <md>
                                        x=\text{number of \$3 price increases}
                                </md>
                                <md>
                                        R(x)=(60+3 x)(200-5 x)=60 \cdot 200-300 x+600 x
                                </md>
                                <md>
                                        R'(x)=300-30 x=0 \quad \Longrightarrow \quad x=10
                                </md>
                                <md>
                                        \text { price }=60+3 \cdot 10=\$90
                                </md>
                                <md>
                                        R^{\prime \prime}=-30&lt;0 \quad\curvearrowright \quad R \text{ is maximized}
                                </md>
                        </p>
                </solution>
        </exercise>
        <exercise>
                <introduction>
                        <p>
				The demand function <m>d(x)</m> and supply function <m>s(x)</m> for a particular commodity are given as: <me>d(x)=330-2x, \; \; s(x)=3x^2+x</me>
			</p>
		</introduction>
		<task>
			<statement>
				<p>
                                        Find the <term>consumers’ surplus</term> at demand level <m>A=5</m>. You do not need to simplify your final numerical answer. Show all work.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                B=330-2 \cdot 5=320
                                        </md>
                                        <md>
                                                \text{surplus}=\int_0^5(330-2 x-320) d x=\int_0^5(10-2 x) d x=10 x-\left.x^2\right|_0 ^5=10 \cdot 5-5^2
                                        </md>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
				<p>
                                        Find the <term>producers’ surplus</term> at demand level <m>A=5</m>. You do not need to simplify your final numerical answer. Show all work.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                s(5)=3 \cdot 5^2+5=75+5=80
                                        </md>
                                        <md>
                                                \text{surplus}=\int_0^5\left[80-\left(3 x^2+x\right)\right] d x=80 x-x^3-\left.\frac{x^2}{2}\right|_0 ^5=80-5-5^3-\frac{5^2}{2}
                                        </md>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
				<p>
                                        Find the market demand (the positive value of <m>x</m> at which the demand function equals the supply function). Show all work.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                \begin{gathered}
                                                330-2 x=3 x^2+x \\
                                                3 x^2+3 x-330=0 \\
                                                3(x+11)(x-10)=0 \\
                                                x=10
                                                \end{gathered}
                                        </md>
                                </p>
                        </solution>
                </task>
        </exercise>
        <exercise>
                <introduction>
			<p>
				For <m>f(x,y)=6x^2-2x^3+3y^2+6xy</m>:
			</p>
		</introduction>
		<task workspace="3in">
                        <statement>
                                <p>
                                        Find <m>f_x, f_y, f_{xx}, f_{yy}</m>, and <m>f_{xy}</m>.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                f_x=12 x-6 x^2+6 y
                                        </md>
                                        <md>
                                                f_y=6 y+6 x
                                        </md>
                                        <md>
                                                f_{x x}=12-12 x
                                        </md>
                                        <md>
                                                f_{y y}=6
                                        </md>
                                        <md>
                                                f_{x y}=6=f_{y x}
                                        </md>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
                                <p>
                                        The critical points of <m>f(x,y)</m> are <m>(0,0)</m> and <m>(1,-1)</m>. Determine, using the <m>D</m>-test, if each point corresponds to a relative maximum, relative minimum, or saddle point. Show all work.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                D=f_{x x} f_{y y}-\left(f_{x y}\right)^2=(12-12 x)(6)-6^2
                                        </md>
                                        <md>
                                                D(0,0)=12 \cdot 6-6^2>0 \quad\text{and}\quad f_{x x}(0,0)=12>0 \Rightarrow (0,0) \text{ is a rel. min.}
                                        </md>
                                <md>
                                        D(1,-1)=(12-12 \cdot 1) \cdot 6-6^2=-6^2&lt;0 \Rightarrow (1,-1) \text{ is a saddle point}
                                </md>
                                </p>
                        </solution>
                </task>
        </exercise>
        <exercise>
                <introduction>
                        <p>
				Evaluate the following improper integral or show that it is divergent. Show all work.
			</p>
                        <p>
                                <m>\displaystyle\int_0^\infty \dfrac{2e^{x}+4e^{2x}}{e^{3x}}dx</m>
                        </p>
                </introduction>
                <solution>
                        <p>
                                <md>
                                        \int_0^b\left(2 e^{-2 x}+4 e^{-x}\right) d x=\frac{2 e^{-2 x}}{-2}+\left.\frac{4 e^{-x}}{-1}\right|_0 ^b=-e^{-2 b}-4 e^{-b}-\left(-e^0-4 e^0\right)
                                </md>
                                <md>
                                        =-e^{-2 b}-4 e^{-b}+5 \quad\Rightarrow\quad \int_0^{\infty} \dfrac{2 e^{x}+4 e^{2 x}}{e^{3 x}} d x=\lim _{b \rightarrow \infty}-e^{-2 b}-4 e^{-b}+5=5
                                </md>
                        </p>
                </solution>
        </exercise>
        <exercise>
                <introduction>
                        <p>
				For <m>f(x,y)=x^3-4xy-8y+3</m>:
			</p>
		</introduction>
                <task workspace="1.5in">
                        <statement>
                                <p>
                                        Compute <m>f(-1,2)</m>. Simplify your answer to a single number.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                f(-1,2)=(-1)^3-4(-1)(2)-8(2)+3=-1+8-16+3=-6
                                        </md>
                                </p>
                        </solution>
                </task>
                <task workspace="1.5in">
                        <statement>
                                <p>
                                        Find the partial derivative <m>f_x</m>.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                f_x=3 x^2-4 y
                                        </md>
                                </p>
                        </solution>
                </task>
                <task workspace="1.5in">
                        <statement>
                                <p>
                                        Find the partial derivative <m>f_y</m>.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                f_y=-4 x-8
                                        </md>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
                                <p>
                                        Find the critical point(s) of <m>f(x,y)</m>. Write each in the form <m>(x,y)</m>. Show all work.
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <md>
                                                \begin{gathered}
                                                3 x^2-4 y=0 \\
                                                -4 x-8=0 \quad x=\dfrac{8}{-4}=-2 \\
                                                3(-2)^2-4 y=0 \\
                                                12-4 y=0 \quad y=3 \\
                                                (-2,3)
                                                \end{gathered}
                                        </md>
                                </p>
                        </solution>
                </task>
        </exercise>
        <exercise>
                <introduction>
			<p>
				Use the graph of <m>y=f'(x)</m> to answer the following. No justification is required.
			</p>
			<p>
				Again, <term>this is the graph of the derivative of <m>f(x)</m>.</term>
			</p>
		</introduction>
                <task>
                        <statement>
                                <p>
                                        On which interval(s) is <m>f(x)</m> decreasing?
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <m>(-\infty,-4)\cup(1,5)</m>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
                                <p>
                                        At which <m>x</m>-value(s) does <m>f(x)</m> have a horizontal tangent line?
                                </p>
                                <p>

                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <m>x=-4,1,5</m>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
                                <p>
                                        What is <m>\displaystyle \lim_{h\to0}\frac{f(h)-f(0)}{h}</m>?
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <m>f'(0)=2</m>
                                </p>
                        </solution>
                </task>
                <task>
                        <statement>
                                <p>
                                        Is <m>f(x)</m> concave up or concave down at <m>x=2</m>?
                                </p>
                        </statement>
                        <solution>
                                <p>
                                        <m>\text{concave down}</m> (since <m>f'</m> is decreasing near <m>x=2</m>)
                                </p>
                        </solution>
                </task>
        </exercise>
</worksheet>
