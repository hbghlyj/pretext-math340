	</introduction>
	<exercise>
		<introduction>
			<p>
				Simplify and reduce each expression to a single fraction.
			</p>
		</introduction>
		<task workspace="2.25in">
			<statement>
				<p>
					<m>\displaystyle \left(\frac{2}{3}-\frac{1}{4}\right) \div\left(\frac{3}{4}+\frac{1}{3}\right)</m>
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle  \frac{-3-(-1^2)}{-(-2)^2+(3-2)^2}</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Solve the equation <m>\displaystyle \frac{5}{4}+\frac{4}{3}x = \frac{1}{4}</m>
			</p>
		</statement>
	</exercise>
	<exercise>
		<statement>
			<p>
				Simplify the expression as much as possible. <me>- (x+2y) - 2(-3y-2x) + 2y</me>
			</p>
		</statement>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find the equation of the line in slope-intercept form that passes through the points <m>(1,-1)</m> and <m>(-1,3)</m>.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Consider the line with the equation <m>-2x + 4y = -8.</m>
			</p>
			<p>
				<em><term>Clearly define your variables. Solve each problem by setting up an algebraic equation and then use that equation to find the solution. There’s no need to simplify any numerical fractions.</term></em>
			</p>
		</introduction>
		<task workspace="1in">
			<statement>
				<p>
					Find the slope of the line above.
				</p>
			</statement>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					Find the <m>x</m>-intercept and <m>y</m>-intercept of the line above.
				</p>
			</statement>
		</task>
		<task workspace="1.75in">
			<statement>
				<p>
					Determine whether the line <m>\displaystyle y - 1 = -2(x+2)</m> is parallel, perpendicular, or neither to the line above. Explain your reasoning.
				</p>
			</statement>
		</task>
		<task workspace="-12pt">
			<statement>
				<p>
					Graph the line <m>-2x + 4y =-8</m>. <em>Clearly label any two points with <m>P</m> and <m>Q</m> on the line.</em>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find three consecutive even integers whose sum is 222.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				A store is offering a 25% discount on a jacket that originally costs $240.
			</p>
		</introduction>
		<task workspace="3in">
			<statement>
				<p>
					What is the amount of the discount?
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					What is the sale price of the jacket after the discount is applied?
				</p>
			</statement>
		</task>
	</exercise>
</worksheet>
