                                        </choice>
                                        <choice>
                                                <statement>
                                                        <p>
                                                                <m>[2,4]</m>
                                                        </p>
                                                </statement>
                                        </choice>
                                        <choice correct="yes">
                                                <statement>
                                                        <p>
                                                                <m>[1,4)</m>
                                                        </p>
                                                </statement>
                                        </choice>
                                        <choice>
                                                <statement>
                                                        <p>
