<?xml version="1.0" encoding="utf-8"?>
<worksheet xml:id="Math211Fa24-Midterm1-PracticeA" xmlns:xi="http://www.w3.org/2001/XInclude">
	<title>Math211Fa24-Midterm1-PracticeA</title>
	<exercise>
		<introduction>
			<p>
				Clearly mark the correct answer for each of the following by completely filling in the appropriate bubble. <term>No justification is needed.</term>
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					<term>(Multiple Choice)</term> The cost of producing <m>x</m> ounces of gold from a new gold mine is <m>C(x)</m> dollars. What does the statement <m>C'(500) = 17</m> mean?
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								The total cost to produce 17 ounces of gold is approximately $500.
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								After 500 ounces of gold have been produced, the average production cost is $17/ounce. So the cost of producing 500 ounces is about $17/ounce.
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								After 500 ounces of gold have been produced, the rate at which the production cost is increasing is $17/ounce. So the cost of producing the 500th (or 501st) ounce is about $17.
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								After 17 ounces of gold have been produced, the average production cost is $500/ounce. So the cost of producing 17 ounces is about $500/ounce.
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					<term>(True/False)</term> If <m>f(t)</m> is the function describing (in feet) the water level in a lake at time <m>t</m> (where <m>t</m> is in hours), and <m>f'(3)=10</m> and <m>f''(3)=-2</m>, then the water level is rising at <m>t=3</m>, but the rate is slowing.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice correct="yes">
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					<term>(True/False)</term> The graph below describes a function in <m>x</m>.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice correct="yes">
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Calculate the derivative of each function. You do not need to simplify your answer.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>g(x)=\dfrac{4}{x^3} + 7</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp g(x)=4 x^{-3}+7 \\
						\amp g'(x)=-12 x^{-4}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>F(x)=(x+1)(2x+3)</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>F'(x)=1 \cdot(2 x+3)+(x+1) \cdot 2</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>r(x)=\displaystyle\sqrt{2x-3}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>r'(x)=\frac{1}{2}(2 x-3)^{-1 / 2} \cdot 2</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>f(x)=(x^2+2x)^8</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>f'(x)=8\left(x^2+2 x\right)^7 \cdot(2 x+2)</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find each limit. Show all work. Simplify your final answers.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					<m>\displaystyle\lim_{x\to 3} \dfrac{ x^2-x-6}{x^2+2x-15}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>\lim _{x \rightarrow 3} \frac{(x+2)(x-3)}{(x+5)(x-3)}=\lim _{x \rightarrow 3} \frac{x+2}{x+5} = \frac{5}{8}</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle \lim_{x\to 0}\dfrac{3x-5}{x^2+3}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>\lim _{x \rightarrow 0} \frac{3 x-5}{x^2+3}=\frac{-5}{3}</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find an equation for the tangent line of <m>f(x)=x^3-5x^2+2</m> at <m>x=1</m>. Show all work.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{array}{ll}
					f'(x)=3 x^2-10 x \amp f(1)=1^3-5 \cdot 1^2+2=-2 \\
					f'(1)=3 \cdot 1^2-10 \cdot 1=-7 . \amp
					\end{array}
				</me>
				The line has slope -7 and contains the point <m>(1,-2)</m>.
				The equation of the tangent line is
				<me>y+2=-7(x-1)</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find <m>f''(x)</m> of <m>f(x)=4x(x+1)</m>. You do not need to simplify your final answer. Show all work.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{aligned}
					\amp f'(x)=4 \cdot(x+1)+4 x \cdot 1=4 x+4+4 x=8 x+4 \\
					\amp f''(x)=8 .
					\end{aligned}
				</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				A baseball bat manufacturer finds that the cost of making <m>x</m> bats is <m>C(x)=40+10x</m>, and the revenue in selling <m>x</m> bats is <m>R(x)=28x-2x^2</m>.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					Find all <m>x</m> value(s) where <m>R(x)=C(x)</m>. Show your work.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp 28 x-2 x^2=40+10 x \\
						\amp 2 x^2-18 x+40=0 \\
						\amp 2\left(x^2-9 x+20\right)=0 \\
						\amp 2(x-4)(x-5)=0 \\
						\amp \text { At } x=4 \text { and } x=5 \text { we have } R(x)=C(x)
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					Find the <term>marginal revenue function</term> <m>MR(x)</m> and evaluate <m>MR(2)</m>. You do not need to simplify your final numerical answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp M R(x)=R'(x)=28-4 x \\
						\amp R'(2)=28-4 \cdot 2=20
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					Find the <term>average cost function</term> <m>AC(x)</m>.
				</p>
			</statement>
			<solution>
				<p>
					<me>A C(x)=\frac{C(x)}{x}=\frac{40+10 x}{x}=10+\frac{40}{x} .</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Find the <term>marginal average cost function</term> <m>MAC(x)</m> and evaluate <m>MAC(2)</m>. You do not need to simplify your final numerical answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp M A C(x)=\left(10+40 x^{-1}\right)'=-40 x^{-2} \\
						\amp M A C(2)=-40 \cdot 2^{-2}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Consider the function <m>y=f(x)</m> below. Answer the following questions.  
			</p>
		</introduction>
		<task workspace="1in">
			<statement>
				<p>
					For which <m>x</m>-value(s) is <m>f'(x)=0</m>? Briefly (one sentence) explain your answer.
				</p>
			</statement>
			<solution>
				<p>
					At <m>x=-2, x=1</m> and <m>x=3</m> the derivative is 0, since the tangent line is horizontal.
				</p>
			</solution>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					Is <m>f'(-1)</m> positive, negative, or zero? Briefly (one sentence) explain your answer.
				</p>
			</statement>
			<solution>
				<p>
					<m>f'(-1)</m> is positive because the tangent line has a positive slope.
				</p>
			</solution>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					Is <m>f'(2)</m> positive, negative, or zero? Briefly (one sentence) explain your answer.
				</p>
			</statement>
			<solution>
				<p>
					<m>f'(2)</m> is negative since the tangent line has a negative slope.
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Use the (limit) definition of the derivative, <me>\displaystyle f'(x)=\lim_{h\to 0}\frac{f(x+h)-f(x)}{h},</me> to compute <m>f'(x)</m> for <m>f(x)=3x^2-4</m>.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{aligned}
					f'(x) \amp =\lim _{h \rightarrow 0} \frac{f(x+h)-f(x)}{h} \\
					\amp =\lim _{h \rightarrow 0} \frac{3(x+h)^2-4-\left(3 x^2-4\right)}{h} \\
					\amp =\lim _{h \rightarrow 0} \frac{3\left(x^2+2 x h+h^2\right)-4-3 x^2+4}{h} \\
					\amp =\lim _{h \rightarrow 0} \frac{3 x^2+6 x h+3 h^2-3 x^2}{h} \\
					\amp =\lim _{h \rightarrow 0} \frac{h(6 x+3 h)}{h} \\
					\amp =\lim _{h \rightarrow 0}(6 x+3 h)=6 x .
					\end{aligned}
				</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				For the graph of <m>y=f(x)</m> below:
			</p>
		</introduction>
		<task workspace="1in">
			<statement>
				<p>
					Give all <m>x</m>-values where <m>f(x)</m> is discontinuous.
				</p>
			</statement>
			<solution>
				<p>
					<m>x=1</m> and <m>x=3</m>.
				</p>
			</solution>
		</task>
		<task workspace="0.5in">
			<statement>
				<p>
					Find each value, if possible. If not possible, write DNE.
				</p>
				<p>
					(a) <m>\displaystyle \lim_{x\to 1^-} f(x)=</m>
				</p>
				<p>
					(b) <m>\displaystyle \lim_{x\to 1^+} f(x)=</m>
				</p>
				<p>
					(c) <m>\displaystyle \lim_{x\to 1} f(x)=</m>
				</p>
				<p>
					(d) <m>\displaystyle \lim_{x\to 3} f(x)=</m>
				</p>
			</statement>
			<solution>
				<p>
					(a) <m>\lim _{x \rightarrow 1^{-}} f(x)=-\infty</m>
				</p>
				<p>
					(b) <m>\lim _{x \rightarrow 1^{+}} f(x)=\infty</m>
				</p>
				<p>
					(c) <m>\lim _{x \rightarrow 1} f(x)=</m> DNE
				</p>
				<p>
					(d) <m>\lim _{x \rightarrow 3} f(x)=1</m>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<task workspace="1in">
			<statement>
				<p>
					Given the graph of <m>y=f(x)</m> below, give the domain and the range of <m>f(x)</m>. Use interval notation.
				</p>
				<p>
					Domain:
				</p>
				<p>
					Range:
				</p>
			</statement>
			<solution>
				<p>
					Domain: <m>[-2,5]</m>
					Range: <m>(-1,5]</m>
				</p>
			</solution>
		</task>
		<task workspace="1.5in">
			<statement>
				<p>
					Simplify <m>\dfrac{x^2}{4\sqrt{x}}</m> to the form <m>ax^b</m>, where <m>a</m> and <m>b</m> are both numbers.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\frac{x^2}{4 \sqrt{x}}=\frac{x^{2-1 / 2}}{4}= \amp \frac{x^{3 / 2}}{4}=\frac{1}{4} x^{3 / 2} \\
						\amp (a=1 / 4, b=3 / 2) .
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task workspace="0.5in">
			<statement>
				<p>
					For <m>f(x)=2x-1</m> and <m>g(x)=\sqrt{x+3}</m>, Write down expressions for each function composition. You do not need to simplify.
				</p>
				<p>
					<m>f(g(x))=</m>
				</p>
				<p>
					<m>g(f(x))=</m>
				</p>
				<p>
					<m>f(f(x))=</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp f(g(x))=2 \sqrt{x+3}-1 \\
						\amp g(f(x))=\sqrt{(2 x-1)+3} \\
						\amp f(f(x))=2(2 x-1)-1
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
	</exercise>
</worksheet>
