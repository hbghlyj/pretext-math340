	</exercise>
	<exercise>
		<introduction>
			<p>
				Use the limit definition of the derivative to compute <m>f'(x)</m> for <m>f(x)=3x+x^2</m>.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{aligned}
					f'(x)=\lim _{h \rightarrow 0} \frac{f(x+h)-f(x)}{h} \amp =\lim _{h \rightarrow 0} \frac{3(x+h)+(x+h)^2-\left(3 x+x^2\right)}{h} \\
					\amp =\lim _{h \rightarrow 0} \frac{3 x+3 h+x^2+2 x h+h^2-3 x-x^2}{h} \\
					\amp =\lim _{h \rightarrow 0} \frac{h(3+2 x+h)}{h} \\
					\amp =\lim _{h \rightarrow 0} 3+2 x+h=3+2 x+0=3+2 x
					\end{aligned}
				</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Suppose the graph below is <m>f'(x)</m>. Assume each tick mark is 1 unit.
			</p>
			<p>
				
			</p>
			<p>
				 
			</p>
		</introduction>
		<task workspace="1.5in">
			<statement>
				<p>
					At which <m>x</m>-values does <m>f(x)</m> have a horizontal tangent line? Briefly explain your answer.
				</p>
				<p>
					 
				</p>
			</statement>
			<solution>
				<p>
					<m>x=-4,0,3,6 \rightarrow</m> where <m>f'(x)=0</m>.
				</p>
			</solution>
		</task>
		<task workspace="1.5in">
			<statement>
				<p>
					On which intervals is <m>f(x)</m> increasing? Briefly explain your answer.
				</p>
				<p>
					 
				</p>
			</statement>
			<solution>
				<p>
					<m>(-4,1) \cup(3,6) \rightarrow</m> where <m>f'(x)\gt 0</m> (above <m>x</m>-axis).
				</p>
			</solution>
		</task>
		<task workspace="1.5in">
			<statement>
				<p>
					On which intervals is <m>f(x)</m> decreasing?Briefly explain your answer. 
				</p>
			</statement>
			<solution>
				<p>
					<m>(-\infty,-4) \cup(1,3) \cup(6, \infty) \rightarrow</m> where <m>f'(x)\lt 0</m> (below <m>x</m>-axis).
				</p>
			</solution>
		</task>
	</exercise>
