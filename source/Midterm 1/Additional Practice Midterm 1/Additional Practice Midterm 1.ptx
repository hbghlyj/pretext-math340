<worksheet xml:id="Math211Fa24-Midterm1-PracticeB" xmlns:xi="http://www.w3.org/2001/XInclude">
	<title>Math211Fa24-Midterm1-PracticeB</title>
	<exercise>
		<introduction>
			<p>
				Clearly mark the correct answer(s) for each of the following by completely filling in the appropriate bubble. <term>No justification is needed.</term>
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					<term>(Multiple Choice-Choose one)</term> Where does <m>f(x)=x-3\sqrt{x}</m> have a horizontal tangent line?
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								<m>x=0</m>
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								<m>x=1</m>
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								<m>x=\frac{1}{2}</m>
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								<m>x=\frac{9}{4}</m>
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								None of the above.
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					<term>(True/False)</term> If <m>f(x)=x^2+2</m> and <m>g(x)=4x+3</m>, <m>f(g(x))=g(f(x))</m>.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								True
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								False
							</p>
						</statement>
					</choice>
				</choices>
		</task>
		<task>
			<statement>
				<p>
					<term>(Choose all that apply)</term> Given the graph of <m>y=f(x)</m> below, where is <m>f(x)</m> discontinuous?
				</p>
			</statement>
				<choices multiple-correct="yes">
					<choice correct="yes">
						<statement>
							<p>
								<m>x=-1</m>
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								<m>x=1</m>
							</p>
						</statement>
					</choice>
					<choice correct="yes">
						<statement>
							<p>
								<m>x=3</m>
							</p>
						</statement>
					</choice>
					<choice>
						<statement>
							<p>
								None of the above.
							</p>
						</statement>
					</choice>
				</choices>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Calculate the derivative of each function. You do not need to simplify your answer.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>\displaystyle g(x)=x^3-3(x^2+10^2)</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>g'(x)=3 x^2-6 x</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>\displaystyle r(x)=\sqrt{x+\sqrt{x}}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>r'(x)=\frac{1}{2}(x+\sqrt{x})^{-1 / 2}\left(1+\frac{1}{2} x^{-1 / 2}\right)</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>\displaystyle f(t)=\frac{7}{t^{4/3}}-8t</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>f'(t)=\frac{-28}{3} t^{-7 / 3}-8</me>
				</p>
			</solution>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>f(x)=(x^3+2x-7)(x^4-3x^2+x)</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>f'(x)=\left(3 x^2+2\right)\left(x^4-3 x^2+x\right)+\left(x^3+2 x-7\right)\left(4 x^3-6 x+1\right)</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Given the graph of <m>f(x)</m> and the graph of <m>g(x)</m> below:
			</p>
			<p>
				Find each limit. Show all work. Simplify your final answers.
			</p>
		</introduction>
		<task workspace="1in">
			<statement>
				<p>
					Give the domain and range of <m>f(x)</m>. Use interval notation.
				</p>
			</statement>
			<solution>
				<p>
					Domain: <m>[-4,3)</m>
					Range: <m>[-4,6)</m>
				</p>
			</solution>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					Give the domain and range of <m>g(x)</m>. Use interval notation.
				</p>
			</statement>
			<solution>
				<p>
					Domain: <m>[-3,-1) \cup(-1,5]</m>
					Range: <m>[-4,2)</m>
				</p>
			</solution>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					What is <m>g(f(-3))</m>?
				</p>
			</statement>
			<solution>
				<p>
					<m>g(-2)=-1</m>
				</p>
			</solution>
		</task>
		<task workspace="1in">
			<statement>
				<p>
					Find <m>F'(2)</m>, where <m>F(x)=f(x)g(x)</m>. You do not need to simplify your final numerical answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						F'(x) \amp =f'(x) g(x)+f(x) g'(x) \\
						F'(2) \amp =f'(2) g(2)+f(2) g'(2) \\
						\amp =2 \cdot 1+4 \cdot \frac{1}{3}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle\lim_{x\to 1} \dfrac{x^2-4x+4}{x^3+5x^2-14x}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp \lim _{x \rightarrow 1} \frac{x^2-4 x+4}{x^3+5 x^2-14 x}=\frac{1^2-4 \cdot 1+4}{1^3+5 \cdot 1^2-14 \cdot 1} \\
						\amp =\frac{1}{6-14}=-\frac{1}{8}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle\lim_{x\to 4} \dfrac{x^2+x-20}{2x^2-6x-8}</m>
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						\amp \lim _{x \rightarrow 4} \frac{(x+5)(x-4)}{2\left(x^2-3 x-4\right)}=\lim _{x \rightarrow 4} \frac{(x+5)(x-4)}{2(x-4)(x+1)} \\
						\amp =\lim _{x \rightarrow 4} \frac{x+5}{2(x+1)}=\frac{4+5}{2(4+1)}=\frac{9}{10}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find an equation for the tangent line of the function <m>f(x)=x-2x^2</m> at <m>x=3</m>. Show all work.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{aligned}
					f'(x) \amp =1-4 x \\
					f'(3) \amp =1-4 \cdot 3=-11 \quad \text{(slope)} \\
					f(3) \amp =3-2 \cdot 3^2=3-18=-15 \\
					y+15 \amp =-11(x-3)
					\end{aligned}
				</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find <m>g''(x)</m> of <m>g(x)=4\sqrt{x}-\dfrac{1}{x^2}</m>. You do not need to simplify your final answer. Show all work.
			</p>
		</introduction>
		<solution>
			<p>
				<me>
					\begin{aligned}
					\amp g'(x)=4 \cdot \frac{1}{2} x^{-1 / 2}+2 x^{-3} \\
					\amp g''(x)=4 \cdot \frac{1}{2} \cdot\left(-\frac{1}{2}\right) x^{-3 / 2}-6 x^{-4}
					\end{aligned}
				</me>
			</p>
		</solution>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Suppose a USB manufacturer finds that the cost of producing <m>x</m> total USBs is <m>C(x)=40+24x^{1/3}</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Find the marginal cost function <m>MC(x)</m> and evaluate it at <m>x=8</m>. Simplify your answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						MC(x)=C'(x) \amp =24 \cdot \frac{1}{3} x^{-2 / 3} \\
						C'(8) \amp =8 \cdot 8^{-2 / 3}=\frac{8}{\left(8^{1/3}\right)^2}=\frac{8}{2^2}=2
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Find the marginal average cost function <m>MAC(x)</m> and evaluate it at <m>x=8.</m> Simplify your answer.
				</p>
			</statement>
			<solution>
				<p>
					<me>
						\begin{aligned}
						AC(x) \amp =\frac{C(x)}{x}=\frac{40+24 x^{1 / 3}}{x}=\frac{40}{x}+24 x^{-2/3} \\
						MAC(x)=\left(\frac{C(x)}{x}\right)' \amp =-40 x^{-2}+\underbrace{24 \cdot\left(-\frac{2}{3}\right)}_{-16} x^{-5 / 3} \\
						MAC(8) \amp =\frac{-40}{8^2}+\frac{-16}{\left(8^{1 / 3}\right)^5} \\
						\amp =\frac{-5}{8}+\frac{-16}{2^5}=\frac{-5}{8}-\frac{1}{2} \\
						\amp =\frac{-5}{8}-\frac{4}{8}=\frac{-9}{8}
						\end{aligned}
					</me>
				</p>
			</solution>
		</task>
	</exercise>
	<exercise>
