	<exercise>
		<introduction>
			<p>
				Find solutions to the given quadratic equations by any appropriate method.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>x^2 = -4x + 5</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>3x^{2}-7x +2 =0</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Simplify the following expressions. (<m>x</m>, <m>y</m>, and <m>z</m> are non-negative.)
			</p>
		</introduction>
		<task workspace="1.5in">
			<statement>
				<p>
					<m>\displaystyle \sqrt{ \frac{36x^4y^2}{9x^2y^8} }</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>\sqrt[3]{27 x^{12} y^6 z^9}</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find a polynomial expression that represents the area of the figure below. <em>Fully expand your polynomial answer.</em>
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Expand the following expressions.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>(3x - 2)(x + 4)(2 - x)</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>(m - 2)(m^2 + 2m + 4)</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Convert the following expressions to radical form and simplify if possible.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Perform the indicated operations. <em>Simplify the expression as much as possible.</em>
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>\displaystyle 5\sqrt{2} - 2\sqrt{50}</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>\left( \sqrt{16x^4y^2} \right) \cdot \left( 2xy\sqrt{9x^2y^6} \right)</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Divide the expression <m>(x^3 + 2x^2 - 5x + 6) \div (x - 1)</m> and find the quotient and the remainder.
			</p>
			<p>
				Quotient: Remainder:
			</p>
		</statement>
	</exercise>
