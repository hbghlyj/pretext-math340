	<exercise>
		<introduction>
			<p>
				Find solutions to the given quadratic equations by any appropriate method.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>x^2-5x= -6</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>2x^{2}-5x +2 =0</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Simplify the following expressions. (<m>x</m>, <m>y</m>, and <m>z</m> are non-negative.)
			</p>
		</introduction>
		<task workspace="1.5in">
			<statement>
				<p>
					<m>\displaystyle \sqrt{ \frac{4x^3y^6}{64x^7y^2} }</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>\sqrt[3]{8 x^9 y^3 z^{27}}</m>.
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find a polynomial expression that represents the area of the figure below. <em>Fully expand your polynomial answer.</em>
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Expand the following expressions.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>(-2x+1)(x+3)(1-x)</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>(k+1)(k^2-k+1)</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Convert the following expressions to radical form and simplify if possible.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Perform the indicated operations. <em>Simplify the expression as much as possible.</em>
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>\displaystyle 2\sqrt{3}-\sqrt{27}</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>\left(\sqrt{9x^6y^4}\right) \cdot \left(3x^3\sqrt{25x^2y^4}\right)</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Divide the expression <m>(x^3-4x^2+3x+1)\div (x+2)</m> and find the quotient and the remainder.
			</p>
			<p>
				Quotient: Remainder:
			</p>
		</statement>
	</exercise>
