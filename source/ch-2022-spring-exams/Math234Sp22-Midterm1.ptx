<?xml version="1.0" encoding="utf-8"?>
<worksheet xml:id="Math234Sp22-Midterm1" xmlns:xi="http://www.w3.org/2001/XInclude">
	<title>Math 234 - Midterm 1 - Spring 2022</title>
	<exercise>
		<introduction>
			<p>
				Let <m>\vec{a}=\hat{\imath}-2 \hat{k}</m> and <m>\vec{b}=2 \hat{\imath}+3 \hat{\jmath}-\hat{k}</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Are the vectors <m>\vec{a}</m> and <m>\vec{b}</m> orthogonal?
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Find the area of the triangle with corners at the origin, the point <m>(1,0,-2)</m>, and the point <m>(2,3,-1)</m>.
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Find the equation of the plane that contains the vectors <m>\vec{a}</m> and <m>\vec{b}</m> and that passes through the point <m>(0,2,3)</m>.
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				An object's acceleration is given by
				<me>\vec{a}(t)=\langle t+2, \cos (t), t^2+1\rangle.</me>
				Find a vector equation <m>\vec{r}(t)</m> for the position of the object at time <m>t</m> if its initial velocity is <m>\vec{v}(0)=\langle 0,1,2 \rangle</m> and its initial position is <m>\vec{r}(0)=\langle 1,0,0 \rangle</m>.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Two particles begin moving at time <m>t=0</m> seconds. Particle <m>P_1</m> has path given by <m>\vec{r}_1(t)=\langle 2 t^2, t+1,5\rangle</m>. Particle <m>P_2</m> has path given by <m>\vec{r}_2(t)=\langle t^2-t-18, t-3, t\rangle</m>. The paths of these two particles intersect at some point <m>Q</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Find point <m>Q</m>.
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Do the particles collide at <m>Q</m>? If so, show why. If not, which arrives at <m>Q</m> first?
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Which particle is traveling faster when it arrives at <m>Q</m>?
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Show that the acceleration vectors for both particles are parallel.
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Let <m>\vec{r}(t)=\langle e^{4 t^2}, 9 t, 5 t^2+1\rangle</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Write down an integral that represents the length of the curve, with <m>0 \leq t \leq 2</m>. You do NOT need to solve the integral.
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Find a parametric equation for the tangent line to the curve at <m>t=1</m>.
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Let <m>\vec{r}(t)=\langle 4 \cos (t), t, 4 \sin (t)\rangle</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Find the unit tangent vector, <m>\vec{T}(t)</m>.
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Find the unit normal vector, <m>\vec{N}(t)</m>.
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Find the curvature, <m>\kappa(t)</m>.
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find a vector function that parametrizes the curve of intersection of the surfaces <m>y=-x^2+2 z</m> and <m>x^2+z^2=16</m>.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Consider the function <m>f(x, y)=\sqrt{y-x^2}</m>.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Sketch the domain of the function. Shade the region(s) that are part of the domain. Use dotted lines when sketching a curve that is NOT in the domain, and solid lines when sketching curves that are.
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					Sketch the level curves of <m>f(x, y)</m> for <m>k=0,1,2</m> (there should be three curves total). Label each curve with the appropriate value of <m>k</m> and indicate in your sketch the <m>x</m> and <m>y</m> intercepts for the curves (if they exist).
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Let <m>f(x, y)=\frac{4 x y^3}{2 x^2 y^2+5 y^4}</m>. Show that <m>\lim _{(x, y) \rightarrow(0,0)} f(x, y)</m> does not exist.
			</p>
		</statement>
	</exercise>
</worksheet>
