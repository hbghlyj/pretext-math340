	</introduction>
	<exercise>
		<statement>
			<p>
				Determine the solution set for the given inequality, express it in interval notation, and illustrate it graphically on a number line. <me>-x +7 \leq -6x</me>
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find the solution set for the inequality, express the solution set using interval notation, and represent it graphically on a number line.
			</p>
		</introduction>
		<task workspace="1.6in">
			<statement>
				<p>
					<m>\displaystyle \left\vert \frac{3}{4} x -2 \right\vert \leq 1</m>
				</p>
			</statement>
		</task>
		<task workspace="2.0in">
			<statement>
				<p>
					<m>|1-x| \geq 5</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find the solutions for the equation, <me>\frac{1}{2}\vert 4x-2 \vert = 3</me>
			</p>
		</statement>
	</exercise>
</worksheet>
