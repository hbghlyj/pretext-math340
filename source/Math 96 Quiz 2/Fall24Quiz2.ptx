		<!-- Horizontal Rule Not Implimented -->
	</introduction>
	<exercise>
		<statement>
			<p>
				Find the solution set for the inequality, express the solution set using interval notation, and represent it graphically on a number line. <me>2x - 5 \leq -3x</me>
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find the solution set for the inequality, express the solution set using interval notation, and represent it graphically on a number line.
			</p>
		</introduction>
		<task workspace="1.6in">
			<statement>
				<p>
					<m>\displaystyle \left\vert \frac{1}{2} x+1 \right\vert \leq 3</m>
				</p>
			</statement>
		</task>
		<task workspace="2.0in">
			<statement>
				<p>
					<m>|-1+x| \geq 2</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find the solutions for the equation, <me>\frac{1}{3}\vert 3x-2 \vert = 1</me>
			</p>
		</statement>
	</exercise>
</worksheet>
