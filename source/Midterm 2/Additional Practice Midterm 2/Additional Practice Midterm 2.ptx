		</task>
		<task>
			<statement>
				<p>
					<term>(True/False)</term> <m>f(x)=e^{x^2-x}</m> has a critical number at <m>x=0</m>.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								True
							</p>
