		</task>
		<task>
			<statement>
				<p>
					<term>(True/False)</term> A Hyundai Sonata lists for <m>\$ 22,000</m> and depreciates in value by <m>30\%</m> each year. In 3 years, it will be worth <m>22,000(.3)^3</m>.
				</p>
			</statement>
				<choices multiple-correct="no">
					<choice>
						<statement>
							<p>
								True
							</p>
