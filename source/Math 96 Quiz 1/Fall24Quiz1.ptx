<?xml version="1.0" encoding="utf-8"?>
<worksheet xml:id="Math-96-Quiz-1-Fall24Quiz1" xmlns:xi="http://www.w3.org/2001/XInclude">
	<title>Math-96-Quiz-1-Fall24Quiz1</title>
	<introduction>
		<p>
				<term>MATH 96</term> <term>Name:</term><!-- linebreak --><term>Fall 2024</term><!-- linebreak --><term>Quiz 1 Version A</term><!-- linebreak --><term>20 Minutes</term>
			</p>
		<!-- Horizontal Rule Not Implimented -->
			<p>
				You may <em>not</em> use textbooks, course notes, or a calculator during this exam. Organize your work in a reasonable, neat, and coherent way. Any answer must be supported by calculations, explanation, and/or algebraic work to receive full credit. Partial credit may be given.<!-- linebreak -->
			</p>
		<!-- Horizontal Rule Not Implimented -->
	</introduction>
	<exercise>
		<introduction>
			<p>
				Simplify each expression fully.
			</p>
		</introduction>
		<task workspace="2.75in">
			<statement>
				<p>
					<m>\displaystyle 3(-4n + 2) + 6(n - 1)</m>
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle \frac{(-3)^3-2^3}{-2^3 + 3^2 +4}</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Solve each linear equation. <em>Show your work for credit.</em>
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					<m>-2x +3 = 9</m>
				</p>
			</statement>
		</task>
		<task workspace="4.25in">
			<statement>
				<p>
					<m>3 (2 - 4x) = 2x- 8</m>
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle \frac{1}{4} + \left( -\frac{2}{3} x  \right)= \frac{3}{12}</m>
				</p>
			</statement>
		</task>
	</exercise>
</worksheet>
