	<exercise>
		<introduction>
			<p>
				Simplify and reduce each expression to a single fraction.
			</p>
		</introduction>
		<task workspace="2.25in">
			<statement>
				<p>
					<m>\displaystyle \left(\frac{1}{6}-\frac{2}{9}\right) \cdot \left(\frac{1}{5}+\frac{1}{4}\right)</m>
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle \frac{(-4)^2-(-1)^2}{-4^2-(-1^2-2)}</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Solve  <m>\displaystyle \frac{1}{3}\left\vert 2x - 5 \right\vert = 2</m>.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Consider the line with the equation <m>-2x + 5y -10 = 0</m>.
			</p>
		</introduction>
		<task workspace="1.5in">
			<statement>
				<p>
					Find the slope and the <m>y</m>-intercepts of the line above.
				</p>
			</statement>
		</task>
		<task workspace="1.75in">
			<statement>
				<p>
					Determine whether the line <m>\displaystyle y -1 = -\frac{5}{2}(x+2)</m> is parallel, perpendicular, or neither to the line above. Explain your reasoning.
				</p>
			</statement>
		</task>
		<task workspace="2pt">
			<statement>
				<p>
					Graph the lines <m>-2x + 5y -10 = 0</m> and <m>\displaystyle y -1 = -\frac{5}{2}(x+2)</m>. <em>Clearly label two points on each line.</em>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Determine the solutions for the provided inequalities and represent the solution sets using interval notation.
			</p>
		</introduction>
		<task workspace="2.5in">
			<statement>
				<p>
					<m>\displaystyle 6 \leq 3\left\vert x - 4 \right\vert</m>
				</p>
			</statement>
		</task>
		<task workspace="2.5in">
			<statement>
				<p>
					<m>\displaystyle 1 \geq 3x-2 &gt; -1</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Perform the indicated operations. <em>Simplify the expression as much as possible.</em>
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Expand the following expressions.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>-(x - 2)(3x + 5)</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>(m - 1)(m^2 + 2m + 4)</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find solutions to the given quadratic equations by any appropriate method.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>3x^2 - 6x = 9</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>-x^2 = -3x - 5</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				For the function <m>f(x)=2x^2-4x-3</m>, determine the following.
			</p>
		</introduction>
		<task workspace=".5in">
			<statement>
				<p>
					<m>y</m>-intercept
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					The vertex form <m>f(x)=a(x-h)^2+k</m>, with <m>a, h, k</m> values.
				</p>
			</statement>
		</task>
		<task workspace="1.5in">
			<statement>
				<p>
					<m>x</m>-intercepts
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find the restricted values of <m>\displaystyle \frac{x^2 - 9}{x^2 + 2x - 3}</m> and simplify the rational expression as much as possible.
			</p>
		</statement>
	</exercise>
</worksheet>
