	<exercise>
		<introduction>
			<p>
				Simplify and reduce each expression to a single fraction.
			</p>
		</introduction>
		<task workspace="2.25in">
			<statement>
				<p>
					<m>\displaystyle \left(\frac{2}{3}-\frac{1}{4}\right) \cdot \left(\frac{2}{5}+\frac{2}{3}\right)</m>
				</p>
			</statement>
		</task>
		<task>
			<statement>
				<p>
					<m>\displaystyle  \frac{(-3)^2-(-2)^2}{-3^2-(-2^2-3)}</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Solve  <m>\displaystyle \frac{1}{2}\left\vert -x + 1 \right\vert = 4</m>.
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Consider the line with the equation <m>-x + 2y -2 = 0</m>.
			</p>
		</introduction>
		<task workspace="1.5in">
			<statement>
				<p>
					Find the slope and the <m>y</m>-intercepts of the line above.
				</p>
			</statement>
		</task>
		<task workspace="1.75in">
			<statement>
				<p>
					Determine whether the line <m>\displaystyle y -2 = -2(x+3)</m> is parallel, perpendicular, or neither to the line above. Explain your reasoning.
				</p>
			</statement>
		</task>
		<task workspace="2pt">
			<statement>
				<p>
					Graph the lines <m>-x + 2y -2 = 0</m> and <m>\displaystyle y -2 = -2(x+3)</m>. <em>Clearly label two points on each line.</em>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Determine the solutions for the provided inequalities and represent the solution sets using interval notation.
			</p>
		</introduction>
		<task workspace="2.5in">
			<statement>
				<p>
					<m>\displaystyle 6 \geq 2\left\vert -1  + x \right\vert</m>
				</p>
			</statement>
		</task>
		<task workspace="2.5in">
			<statement>
				<p>
					<m>\displaystyle 0 \leq 2x-1 &lt; 3</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Perform the indicated operations. <em>Simplify the expression as much as possible.</em>
			</p>
		</statement>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Expand the following expressions.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>-(x+1)(-4-3x)</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>(k+1)(k^2-k+1)</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				Find solutions to the given quadratic equations by any appropriate method.
			</p>
		</introduction>
		<task workspace="2in">
			<statement>
				<p>
					<m>2x^2+2x=12</m>
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					<m>-x^2 = 4x - 5</m>
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<introduction>
			<p>
				For the function <m>f(x)=2x^2-5x+3</m>, determine the following.
			</p>
		</introduction>
		<task workspace=".5in">
			<statement>
				<p>
					<m>y</m>-intercept
				</p>
			</statement>
		</task>
		<task workspace="2in">
			<statement>
				<p>
					The vertex form <m>f(x)=a(x-h)^2+k</m>, with <m>a, h, k</m> values.
				</p>
			</statement>
		</task>
		<task workspace="1.5in">
			<statement>
				<p>
					<m>x</m>-intercepts
				</p>
			</statement>
		</task>
	</exercise>
	<exercise>
		<statement>
			<p>
				Find the restricted values of <m>\displaystyle \frac{x+3}{x^2+4x+3}</m> and simplify the rational expression as much as possible.
			</p>
		</statement>
	</exercise>
</worksheet>
